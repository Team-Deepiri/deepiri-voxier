# Serves the Godot Web export as static files.
#
# The COOP/COEP headers are not optional: Godot 4 web exports use
# SharedArrayBuffer, which browsers only expose in a cross-origin-isolated
# context. Without both headers the page loads and the engine silently fails to
# start — a blank canvas that reads like a broken build.
#
# They are set here as well as at the edge so the image is correct on its own,
# rather than depending on whoever proxies to it.
FROM nginx:alpine

COPY Voxier/build/web/ /usr/share/nginx/html/

RUN printf '%s\n' \
  'server {' \
  '    listen 80;' \
  '    server_name _;' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '' \
  '    add_header Cross-Origin-Opener-Policy same-origin always;' \
  '    add_header Cross-Origin-Embedder-Policy require-corp always;' \
  '    add_header Cross-Origin-Resource-Policy same-origin always;' \
  '' \
  '    # NO types{} block here. A types block in server context REPLACES the' \
  '    # entire inherited MIME map rather than adding to it, so declaring just' \
  '    # wasm made nginx serve index.html as application/octet-stream, so the' \
  '    # browser downloaded the page instead of rendering it. The default' \
  '    # /etc/nginx/mime.types is included at http level and already maps wasm.' \
  '' \
  '    location = /health { access_log off; return 200 "healthy\\n"; }' \
  '' \
  '    location / { try_files $uri $uri/ /index.html; }' \
  '}' \
  > /etc/nginx/conf.d/default.conf
